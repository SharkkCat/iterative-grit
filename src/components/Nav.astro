---
import { profile } from '../data/site';
import { url } from '../lib/url';

interface Props {
  back?: boolean;
}
const { back = false } = Astro.props;
---

<header class="nav wrap">
  {
    back ? (
      <a class="back mono" href={url('/#runs')}>← All runs</a>
    ) : (
      <a class="brand" href={url('/')}>
        <svg width="24" height="24" viewBox="0 0 22 22" aria-hidden="true">
          <polyline points="2,19 7,12 12,15 20,3" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="brand-text">
          <span class="brand-name">{profile.name}</span>
          <span class="brand-domain mono">{profile.domain}</span>
        </span>
      </a>
    )
  }
  {
    back ? (
      <span class="mono faint small">{profile.name} · {profile.domain}</span>
    ) : (
      <nav aria-label="Main">
        <a href={url('/#experience')}>Experience</a>
        <a href={url('/#runs')}>Projects</a>
        <a href={url('/#skills')}>Skills</a>
        <a class="btn btn-ghost btn-sm" href={profile.links.resume}>Résumé ↓</a>
      </nav>
    )
  }
</header>

<style>
  .nav {
    display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center;
    padding-top: 24px; padding-bottom: 24px;
  }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-weight: 700; font-size: 16px; }
  .brand-domain { font-size: 11px; color: var(--faint); }
  nav { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; font-size: 15px; }
  nav a:not(.btn) { color: var(--muted); text-decoration: none; padding: 10px 0; }
  nav a:not(.btn):hover { color: var(--accent); }
  .back { font-size: 14px; color: var(--muted); text-decoration: none; padding: 10px 0; }
  .small { font-size: 13px; }
  /* Bottom rule aligned with the content column, not the gutter */
  .nav.wrap { position: relative; }
  .nav.wrap::after { content: ''; position: absolute; left: 24px; right: 24px; bottom: 0; border-bottom: 1px solid var(--line); }
</style>
